// Minimal LFR case corresponding to a NOZZLE DROPLET GENERATOR.
// 3-port junction: oil on the facing pair (1 / 3), water on 4.
// 1-port horn: droplets on 2. Rotation 90 is the vertical pose
// (oil left/right, water in the middle, horn up).
module nozzle_droplet_generator(
    finput oil_left, oil_right, aqueous,
    foutput droplets
);
    #MAP "NOZZLE DROPLET GENERATOR" "~"
    #CONSTRAIN "~" droplet_rate = 30 hz
    #CONSTRAIN "~" rotation = 90
    assign droplets = ~aqueous;
endmodule
